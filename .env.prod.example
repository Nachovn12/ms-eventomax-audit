# ==============================================================================
# ms-eventomax-audit — Production Environment Template (.env.prod.example)
# ==============================================================================

# PostgreSQL / Flyway (Schema: audit)
DB_URL=jdbc:postgresql://<POSTGRES_HOST>:5432/eventomax?currentSchema=audit
DB_USER=eventomax_prod
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_SCHEMA=audit
FLYWAY_CREATE_SCHEMAS=true

# Microsoft Entra ID OAuth2 Resource Server
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_AUDIENCE=api://<BACKEND_API_CLIENT_ID>

# Kafka (Out of EP2 evaluative focus; set AUDIT_KAFKA_ENABLED=false on EC2 without Kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AUDIT_KAFKA_ENABLED=false

# JVM Memory Budget (Container mem_limit: 512m)
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
