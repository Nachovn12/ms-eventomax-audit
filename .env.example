# PostgreSQL
POSTGRES_DB=eventomax_audit
DB_URL=jdbc:postgresql://localhost:5435/eventomax_audit
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Kafka
# For Docker Desktop development, use an externally reachable advertised broker address.
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
AUDIT_KAFKA_ENABLED=false

# Copy the approved values used by the BFF. Never paste a token here.
ENTRA_ISSUER_URI=
ENTRA_AUDIENCE=
